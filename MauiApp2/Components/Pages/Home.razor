@page "/"
@using Microsoft.Maui.Networking
@inject NavigationManager Navigation

<div class="container mt-5 text-center" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 mt-5">
                <div class="card-body p-5">
                    <h1 class="display-4 text-primary mb-4">🧠 مرحباً بك</h1>
                    <h3 class="mb-4">في تطبيق اختبار لغة C#</h3>
                    <p class="lead text-muted mb-5">
                        اختبر معلوماتك في الأساسيات، البرمجة الشيئية، هياكل البيانات، والمزيد.
                        <br />
                        هل أنت مستعد للتحدي؟
                    </p>

                    @if (Connectivity.Current.NetworkAccess != NetworkAccess.Internet)
                    {
                        <div class="alert alert-danger">
                            ⚠️ يرجى الاتصال بالإنترنت أولاً لتتمكن من بدء الاختبار.
                        </div>
                        <button class="btn btn-secondary btn-lg px-5" disabled>غير متصل</button>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-lg px-5 shadow" @onclick="StartQuiz">
                            ابدأ الاختبار الآن 🚀
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void StartQuiz()
    {
        // الانتقال إلى صفحة الاختبار
        Navigation.NavigateTo("/quiz");
    }
}